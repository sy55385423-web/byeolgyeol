# ─── 필수 (Anthropic API) ──────────────────────────────────────────────────────
# 선택: 리뷰 후 LLM 보완 답변을 켤 때만 필요합니다.
ANTHROPIC_API_KEY=sk-ant-...

# 선택: 리뷰 후 추가 질문 1회만 짧은 LLM 답변(최대 700 토큰)을 사용합니다.
# 비워 두거나 false면 모든 리포트·추가 질문이 로컬 엔진으로 생성되어 LLM 토큰 비용이 없습니다.
BYEOLGYEOL_LLM_FOLLOW_UPS=false

# ─── 필수 (토스페이먼츠) ────────────────────────────────────────────────────────
# https://developers.tosspayments.com 에서 발급.
# test_ 로 시작하면 테스트 모드, live_ 로 시작하면 실결제.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...
